---
/**
 * Tarjeta de tecnología/curso con resplandor de color al pasar el cursor.
 * Soporta tamaño normal y compacto (`size="sm"`).
 *
 * <SkillCard name="Python" tag="Lenguaje" description="Programa desde cero"
 *            glow="59 130 246" icon="python" course size="sm" />
 */
import SkillIcon from './SkillIcon.astro';
import type { Skill } from '../../data/skills';

interface Props extends Skill {
  size?: 'md' | 'sm';
  variant?: 'cards' | 'icons';
}

const { name, tag, description, glow, icon, href, size = 'md', variant = 'cards' } = Astro.props;
const Tag = href ? 'a' : 'article';
const title = name;
---

{variant === 'icons' ? (
  <Tag
    class="skill-tile"
    href={href}
    style={`--glow:${glow}`}
    title={title}
    aria-label={title}
    data-reveal
  >
    <SkillIcon name={icon} glow={glow} size={52} class="tile-svg" />
    <span class="tile-tooltip" aria-hidden="true">{title}</span>
  </Tag>
) : (
  <Tag
    class:list={['skill-card', `skill-card--${size}`]}
    href={href}
    style={`--glow:${glow}`}
    data-reveal
  >
    <h3>
      {title}
      <span class="tag">{tag}</span>
    </h3>
    <p title={description}>{description}</p>
    <div class="badge">
      <SkillIcon name={icon} glow={glow} />
    </div>
  </Tag>
)}

<style>
  .skill-card {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    text-align: left;
    backdrop-filter: blur(16px);
    background: linear-gradient(180deg, rgba(22, 22, 26, 0.94), rgba(14, 14, 17, 0.96));
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.48),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }

  /* Tamaño normal (md) */
  .skill-card--md {
    height: 104px;
    padding: 26px 145px 0 30px;
    border-radius: 24px;
  }
  .skill-card--md h3 {
    font-size: 20px;
  }
  .skill-card--md p {
    margin-top: 5px;
    font-size: 15px;
  }
  .skill-card--md .badge {
    width: 104px;
    height: 104px;
    top: calc(50% - 52px);
    right: 14px;
  }
  .skill-card--md .badge :global(svg) {
    transform: scale(1.5);
  }
  .skill-card--md:hover .badge :global(svg) {
    transform: scale(1.62);
  }

  /* Tamaño compacto (sm) */
  .skill-card--sm {
    height: 76px;
    padding: 16px 88px 0 20px;
    border-radius: 18px;
  }
  .skill-card--sm h3 {
    font-size: 16px;
    font-weight: 600;
  }
  .skill-card--sm p {
    margin-top: 3px;
    font-size: 13px;
    opacity: 0.85;
  }
  .skill-card--sm .tag {
    font-size: 10px;
    padding: 1px 6px;
  }
  .skill-card--sm .badge {
    width: 72px;
    height: 72px;
    top: calc(50% - 36px);
    right: 8px;
  }
  .skill-card--sm .badge :global(svg) {
    transform: scale(1.15);
  }
  .skill-card--sm:hover .badge :global(svg) {
    transform: scale(1.25);
  }

  .skill-card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 16px 42px rgba(0, 0, 0, 0.55),
      0 0 32px rgb(var(--glow) / 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .skill-card:focus-visible {
    outline: 2px solid #c084fc;
    outline-offset: 3px;
  }

  h3 {
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  p {
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 2px 7px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }

  .badge {
    position: absolute;
    pointer-events: none;
  }
  .badge :global(svg) {
    width: 100%;
    height: 100%;
    transition: transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  /* Resplandor del color de cada stack en el lado derecho */
  .skill-card::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 72%;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.5s ease;
    background: radial-gradient(
      110% 150% at 88% 50%,
      rgb(var(--glow) / 0.5) 0%,
      rgb(var(--glow) / 0.42) 12%,
      rgb(var(--glow) / 0.31) 26%,
      rgb(var(--glow) / 0.2) 42%,
      rgb(var(--glow) / 0.11) 58%,
      rgb(var(--glow) / 0.05) 74%,
      rgb(var(--glow) / 0.015) 88%,
      transparent 100%
    );
  }
  .skill-card:hover::before,
  .skill-card:focus-visible::before {
    opacity: 1;
    animation:
      glowIn 0.9s ease-out both,
      breathe 3.2s ease-in-out 0.9s infinite;
  }
  .skill-card:active::before {
    opacity: 1;
  }
  @keyframes glowIn {
    from { opacity: 0; }
    to { opacity: 0.7; }
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }

  /* Móviles */
  @media (max-width: 480px) {
    .skill-card--md {
      padding: 24px 112px 0 22px;
    }
    .skill-card--md h3 {
      font-size: 18px;
    }
    .skill-card--md .badge {
      width: 84px;
      height: 84px;
      top: calc(50% - 42px);
      right: 10px;
    }
    .skill-card--sm {
      padding: 14px 75px 0 16px;
    }
    .skill-card--sm h3 {
      font-size: 15px;
    }
    .skill-card--sm .badge {
      width: 62px;
      height: 62px;
      top: calc(50% - 31px);
      right: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card::before {
      animation: none !important;
    }
    .skill-card,
    .skill-card::before,
    .badge :global(svg) {
      transition: none;
    }
    .skill-card:hover {
      transform: none;
    }
    .skill-card--md:hover .badge :global(svg) {
      transform: scale(1.5);
    }
    .skill-card--sm:hover .badge :global(svg) {
      transform: scale(1.15);
    }
  }

  /* Variante mosaico: solo ícono */
  .skill-tile {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 20px;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(22, 22, 26, 0.94), rgba(14, 14, 17, 0.96));
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .skill-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(circle at 50% 50%, rgb(var(--glow) / 0.32), transparent 72%);
  }
  .skill-tile:hover {
    transform: translateY(-3px);
    box-shadow:
      0 14px 32px rgba(0, 0, 0, 0.55),
      0 0 26px rgb(var(--glow) / 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .skill-tile:hover::before,
  .skill-tile:focus-visible::before {
    opacity: 1;
  }
  .skill-tile:focus-visible {
    outline: 2px solid #c084fc;
    outline-offset: 3px;
  }
  .skill-tile :global(.tile-svg) {
    transform: scale(1.52);
    transition: transform 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .skill-tile:hover :global(.tile-svg) {
    transform: scale(1.68);
  }
  .tile-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(24, 24, 27, 0.96);
    color: #f4f4f5;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    z-index: 20;
  }
  .skill-tile:hover .tile-tooltip,
  .skill-tile:focus-visible .tile-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
