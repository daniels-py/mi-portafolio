---
/**
 * Apartado de proyecto:
 * - Izquierda: etiqueta, nombre, barra de progreso, descripción y "tools used:" al fondo.
 * - Derecha: contenedor grande estilo ventana de macOS para imagen o video.
 */
import SkillIcon from '../skills/SkillIcon.astro';
import { resolveTechMeta, type Project } from '../../data/projects';

type Props = Project;

const {
  name,
  tag,
  progress,
  progressLabel,
  description,
  toolsLabel = 'tools used:',
  stack,
  extraTags,
  media,
  href,
} = Astro.props;

const techs = stack.map(resolveTechMeta);
const clampedProgress =
  typeof progress === 'number' ? Math.max(0, Math.min(100, progress)) : undefined;
const resolvedProgressLabel = progressLabel ?? 'En desarrollo';
const preview = media[0];
---

<article class="project-showcase rounded-lg bg-[#121214] p-7 sm:p-10">
  <div class="grid grid-cols-1 items-stretch gap-10 lg:grid-cols-[minmax(320px,390px)_1fr] lg:gap-12">
    <!-- Izquierda: Información del proyecto arriba y tools used abajo -->
    <div class="flex flex-col justify-between gap-8">
      <div class="space-y-4">
        <div class="space-y-1.5">
          {tag && (
            <p class="text-sm sm:text-base font-normal text-blue-400">
              {tag}
            </p>
          )}
          <h3 class="text-2xl sm:text-[1.85rem] font-bold tracking-tight text-white leading-[1.18]">
            {href ? (
              <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition">
                {name} ↗
              </a>
            ) : (
              name
            )}
          </h3>
        </div>

        {clampedProgress !== undefined && (
          <div class="w-full max-w-[280px] space-y-2 pt-0.5">
            <div class="flex items-center justify-between text-xs">
              <span class="inline-flex items-center gap-1.5 text-gray-400">
                <span class="h-1.5 w-1.5 rounded-full bg-sky-400/90" aria-hidden="true"></span>
                {resolvedProgressLabel}
              </span>
              <span class="font-medium tabular-nums text-sky-300/90">
                {clampedProgress}%
              </span>
            </div>
            <div
              class="h-1.5 w-full overflow-hidden rounded-full bg-white/[0.08]"
              role="progressbar"
              aria-valuenow={clampedProgress}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label={`${resolvedProgressLabel}: ${clampedProgress}%`}
            >
              <div
                class="h-full rounded-full bg-gradient-to-r from-blue-500/90 to-sky-400/90 transition-all duration-500"
                style={`width: ${clampedProgress}%`}
              />
            </div>
          </div>
        )}

        <p class="pt-1 text-sm sm:text-[15px] text-gray-300/90 leading-relaxed font-light">
          {description}
        </p>
      </div>

      <!-- Herramientas usadas (anclado abajo) -->
      <div class="space-y-3">
        <p class="text-sm text-gray-300/90">{toolsLabel}</p>
        <ul class="flex flex-wrap items-center gap-3" aria-label="Tecnologías usadas">
          {techs.map((tech) => (
            <li
              class="tech-mini group relative flex h-12 w-12 items-center justify-center rounded-xl bg-white/[0.06] shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] transition duration-200 hover:-translate-y-1 hover:bg-white/[0.1]"
              style={`--glow:${tech.glow}`}
              title={tech.name}
            >
              <span class="tech-mini-glow" aria-hidden="true"></span>
              <SkillIcon name={tech.icon} glow={tech.glow} size={32} class="tech-mini-svg" />
              <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-zinc-900/95 px-2.5 py-1 text-xs font-medium text-gray-100 opacity-0 shadow-lg transition duration-150 group-hover:opacity-100">
                {tech.name}
              </span>
            </li>
          ))}
        </ul>
        {extraTags && extraTags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {extraTags.map((item) => (
              <span class="rounded-md bg-white/[0.05] px-2 py-0.5 text-[11px] font-medium text-gray-300">
                {item}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Derecha: Ventana estilo macOS grande para imagen o video -->
    {preview && (
      <div class="group flex flex-col self-center overflow-hidden rounded-2xl bg-zinc-950/90 shadow-2xl ring-1 ring-white/[0.08]">
        <!-- Barra superior estilo macOS -->
        <div class="flex items-center justify-between border-b border-white/[0.08] bg-zinc-900/95 px-4 py-3">
          <div class="flex items-center gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="truncate pl-3 text-xs font-medium text-gray-400">
            {preview.label ?? (preview.type === 'video' ? 'Demo' : 'Vista previa')}
          </span>
          <span class="w-12" aria-hidden="true"></span>
        </div>

        <!-- Contenido multimedia adaptable sin recortes -->
        <div class:list={['relative w-full overflow-hidden', !preview.src && 'aspect-video']}>
          {preview.src ? (
            preview.type === 'video' ? (
              <video
                src={preview.src}
                aria-label={preview.alt}
                class="block h-auto w-full object-contain"
                autoplay
                muted
                loop
                playsinline
                controls
              />
            ) : (
              <img
                src={preview.src}
                alt={preview.alt}
                loading="lazy"
                class="block h-auto w-full transition duration-300 group-hover:scale-[1.02]"
              />
            )
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-[#3b82f6]/35 via-[#2563eb]/20 to-zinc-950 p-6 text-center">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/[0.08] text-blue-300">
                {preview.type === 'video' ? (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                ) : (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
              </div>
              <span class="text-sm font-medium text-gray-200">
                {preview.label ?? (preview.type === 'video' ? 'Video del proyecto' : 'Vista previa del proyecto')}
              </span>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</article>

<style>
  .project-showcase {
    font-family: 'Roboto', sans-serif;
  }

  /* Los SVG de SkillIcon ocupan ~40% del viewBox 110x110; escalarlos los hace nítidos */
  .tech-mini :global(.tech-mini-svg) {
    transform: scale(1.45);
    transition: transform 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .tech-mini:hover :global(.tech-mini-svg) {
    transform: scale(1.62);
  }
  .tech-mini-glow {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    opacity: 0;
    background: radial-gradient(circle, rgb(var(--glow) / 0.35), transparent 70%);
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .tech-mini:hover .tech-mini-glow {
    opacity: 1;
  }
  .tech-mini:hover {
    box-shadow: 0 0 20px rgb(var(--glow) / 0.25);
  }
</style>
