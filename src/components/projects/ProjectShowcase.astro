---
/**
 * Apartado de proyecto:
 * - Izquierda: nombre de la app, breve descripción y mini íconos del stack técnico.
 * - Derecha: 2 contenedores multimedia (imagen o video).
 */
import SkillIcon from '../skills/SkillIcon.astro';
import { resolveTechMeta, type Project } from '../../data/projects';

type Props = Project;

const { name, tag, description, stack, media, href } = Astro.props;
const techs = stack.map(resolveTechMeta);
---

<article class="grid grid-cols-1 items-center gap-10 rounded-3xl bg-zinc-900/70 p-6 sm:p-10 lg:grid-cols-12 lg:gap-12">
  <!-- Izquierda: Información del proyecto y mini stack -->
  <div class="space-y-6 lg:col-span-5">
    <div class="space-y-2.5">
      {tag && (
        <p class="text-xs font-mono uppercase tracking-widest text-blue-400">
          {tag}
        </p>
      )}
      <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition">
            {name} ↗
          </a>
        ) : (
          name
        )}
      </h3>
    </div>

    <p class="text-base sm:text-lg text-gray-300 leading-relaxed font-light">
      {description}
    </p>

    <!-- Íconos del stack técnico -->
    <div class="pt-2">
      <ul class="flex flex-wrap items-center gap-3.5" aria-label="Tecnologías usadas">
        {techs.map((tech) => (
          <li
            class="tech-mini group relative flex h-14 w-14 items-center justify-center rounded-2xl bg-white/[0.04] shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition duration-200 hover:-translate-y-1 hover:bg-white/[0.08]"
            style={`--glow:${tech.glow}`}
            title={tech.name}
          >
            <span class="tech-mini-glow" aria-hidden="true"></span>
            <SkillIcon name={tech.icon} glow={tech.glow} size={36} class="tech-mini-svg" />
            <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-zinc-900/95 px-2.5 py-1 text-xs font-medium text-gray-100 opacity-0 shadow-lg transition duration-150 group-hover:opacity-100">
              {tech.name}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Derecha: contenedor(es) estilo ventana de macOS para imagen o video -->
  <div class:list={['grid grid-cols-1 gap-4 lg:col-span-7', media.length > 1 && 'sm:grid-cols-2']}>
    {media.map((item) => (
      <div class="group flex flex-col overflow-hidden rounded-2xl bg-zinc-950/90 shadow-lg transition duration-300 hover:-translate-y-0.5 hover:shadow-xl">
        <!-- Barra superior estilo macOS -->
        <div class="flex items-center justify-between bg-zinc-900/90 px-3.5 py-2.5 border-b border-white/[0.06]">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="truncate pl-2 text-[11px] font-medium text-gray-400">
            {item.label ?? (item.type === 'video' ? 'Demo' : 'Vista previa')}
          </span>
        </div>

        <!-- Contenido multimedia -->
        <div class:list={['relative w-full overflow-hidden', media.length === 1 ? 'aspect-[16/10]' : 'aspect-[4/3]']}>
          {item.src ? (
            item.type === 'video' ? (
              <video
                src={item.src}
                aria-label={item.alt}
                class="h-full w-full object-cover"
                autoplay
                muted
                loop
                playsinline
                controls
              />
            ) : (
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              />
            )
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-2.5 bg-gradient-to-br from-white/[0.03] to-transparent p-4 text-center">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-gray-400 transition group-hover:text-gray-200">
                {item.type === 'video' ? (
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                ) : (
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
              </div>
              <span class="text-xs font-medium text-gray-400">
                {item.label ?? (item.type === 'video' ? 'Video del proyecto' : 'Imagen del proyecto')}
              </span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</article>

<style>
  /* Los SVG de SkillIcon ocupan ~40% del viewBox 110x110; escalarlos los hace nítidos */
  .tech-mini :global(.tech-mini-svg) {
    transform: scale(1.45);
    transition: transform 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .tech-mini:hover :global(.tech-mini-svg) {
    transform: scale(1.62);
  }
  .tech-mini-glow {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    opacity: 0;
    background: radial-gradient(circle, rgb(var(--glow) / 0.35), transparent 70%);
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .tech-mini:hover .tech-mini-glow {
    opacity: 1;
  }
  .tech-mini:hover {
    box-shadow: 0 0 20px rgb(var(--glow) / 0.25);
  }
</style>
