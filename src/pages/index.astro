---
import '../styles/global.css';
import ProjectShowcase from '../components/projects/ProjectShowcase.astro';
import SkillsSection from '../components/skills/SkillsSection.astro';
import { projects } from '../data/projects';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
			rel="stylesheet"
		/>
		<title>Daniel | Desarrollador de Software</title>
	</head>
	<body class="bg-black text-white selection:bg-blue-500 selection:text-white">
	<div class="fixed inset-0 -z-10 h-full w-full bg-black"></div>

	<!-- Header minimalista -->
	<header class="w-full h-16 border-b border-white/10"></header>

	<main>
		<!-- Presentación Principal -->
		<section class="mx-auto w-full max-w-5xl px-5 pt-16 pb-14 sm:pt-24 sm:pb-16">
			<div>
				<h1>
					<span class="block text-xl sm:text-2xl font-normal tracking-normal text-white/95 mb-1">
						Hola, soy
					</span>
					<span class="block text-6xl sm:text-8xl font-extrabold tracking-tight text-white leading-[0.95]">
						Daniel
					</span>
				</h1>
				<p class="mt-3 text-sm sm:text-base font-normal text-blue-400">
					Desarrollador de Software
				</p>
			</div>
		</section>

		<!-- Proyectos -->
		<section id="proyectos" class="mx-auto w-full max-w-6xl space-y-8 px-5 pb-12">
			{projects.map((project) => <ProjectShowcase {...project} />)}
		</section>

		<!-- Stack técnico / Habilidades (mosaico solo íconos unificado) -->
		<SkillsSection
			variant="icons"
			grouped={false}
			title="Tecnologías que uso"
			subtitle="Lenguajes, frameworks y herramientas con los que construyo mis proyectos."
		/>
	</main>

	<!-- Footer simple -->
	<footer class="border-t border-white/10 py-10 text-center text-sm text-gray-400">
		<p>© {new Date().getFullYear()} Daniel. Construido con Astro & Tailwind CSS.</p>
	</footer>

</body>
</html>
